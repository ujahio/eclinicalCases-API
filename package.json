{
  "name": "clinical-backend",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"yarn dev:server\" \"yarn dev:nextapp\"",
    "dev:server": "yarn create-tables && yarn seeder && nodemon",
    "dev:nextapp": "next dev",
    "build": "next build",
    "start:nextapp": "next start",
    "start": "concurrently \"yarn start:server\" \"yarn start:nextapp\"",
    "lint": "next lint",
    "s3": "serverless s3 start",
    "create-tables": "node create_db_tables.js",
    "delete-tables": "node delete_tables.js",
    "seeder": "node server/seeder.js",
    "dynamodb": "docker run -p 8000:8000 amazon/dynamodb-local -jar DynamoDBLocal.jar -inMemory -sharedDb"
  },
  "dependencies": {
    "@auth/dynamodb-adapter": "^2.2.0",
    "@aws-sdk/client-dynamodb": "^3.624.0",
    "@aws-sdk/client-s3": "^3.627.0",
    "@aws-sdk/lib-dynamodb": "^3.624.0",
    "@aws-sdk/lib-storage": "^3.627.0",
    "@aws-sdk/s3-request-presigner": "^3.627.0",
    "@reduxjs/toolkit": "^2.2.5",
    "@types/draft-js": "^0.11.18",
    "@types/react-draft-wysiwyg": "^1.13.8",
    "aws-sdk": "^2.1632.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "draft-js": "^0.11.7",
    "express": "^4.19.2",
    "formik": "^2.4.6",
    "html2pdf.js": "^0.10.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "next": "14.2.3",
    "pdf-lib": "^1.17.1",
    "pdf-poppler": "^0.2.1",
    "pdf2png-mp": "^0.5.4",
    "pdfkit": "^0.15.0",
    "react": "^18",
    "react-dom": "^18",
    "react-draft-wysiwyg": "^1.15.0",
    "react-hot-toast": "^2.4.1",
    "react-pdf": "^9.1.0",
    "react-redux": "^9.1.2",
    "react-toastify": "^10.0.5",
    "redux-persist": "^6.0.0",
    "redux-persist-transform-filter": "^0.0.22",
    "sass": "^1.77.3",
    "serverless": "^3.2.0",
    "serverless-next.js": "^1.15.0-alpha.2",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "dynamodb-localhost": "^0.0.9",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "nodemon": "^3.1.4",
    "postcss": "^8",
    "serverless-dynamodb-local": "^0.2.40",
    "serverless-http": "^3.2.0",
    "serverless-offline": "^13.6.0",
    "serverless-s3-local": "^0.8.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "serverless-s3-local": {
      "serverless": "$serverless"
    }
  }
}
